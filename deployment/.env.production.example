# LinkedIn AI — PRODUCTION environment template (Linux VPS).
#
# Copy to /etc/linkedin-ai/.env on the server (owner root, mode 600):
#   sudo install -o root -g linkedin -m 640 /dev/null /etc/linkedin-ai/.env
# Fill in real values on the server. NEVER commit real values to Git.
# This file contains placeholders only.

# --- App ---
APP_ENV=production
APP_SECRET_KEY=CHANGE-ME-generate-a-long-random-value
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=https://YOUR_DOMAIN
DATABASE_URL=sqlite:////var/lib/linkedin-ai/data/app.db

# API docs (/docs, /redoc). Off in production unless explicitly needed.
DOCS_ENABLED=false

# --- Providers (mock = local behavior, no external calls) ---
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
LINKEDIN_MODE=mock

# --- Google OAuth (register https://YOUR_DOMAIN/api/auth/google/callback
# in the Google Cloud console first) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback

# --- LinkedIn OAuth (register https://YOUR_DOMAIN/api/linkedin/callback
# in the LinkedIn developer app first) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_DOMAIN/api/linkedin/callback
# Add w_member_social only when publishing is required, then reconnect
# LinkedIn in Settings so the stored connection carries the scope.
LINKEDIN_SCOPES=openid profile email
# Generate on the server:
# /opt/linkedin-ai/backend/.venv/bin/python -c \
#   "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# --- Real AI providers (only when a real provider is implemented) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
