# LinkedIn AI — local development placeholders only. Never commit real secrets.
# Copy to .env for local runs: Copy-Item .env.example .env

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-dev-only
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/app.db
# API docs (/docs, /redoc). Leave empty: on unless APP_ENV=production.

# --- Mock mode (M0 defaults; no credentials needed) ---
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
LINKEDIN_MODE=mock

# --- Google OAuth (M1; empty = NOT CONFIGURED, app still starts) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LinkedIn OAuth (M9; empty = NOT CONFIGURED, app still starts) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
# Space-separated scopes. Identity needs openid/profile/email; M10 publishing
# additionally requires w_member_social (reconnect after adding it so the
# stored connection carries the scope).
LINKEDIN_SCOPES=openid profile email
# Token encryption key (server-side only, never commit a real one).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, real LinkedIn connections are refused rather than stored plaintext.
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# --- Video transcription (mock = clearly-labeled placeholder transcript) ---
TRANSCRIPTION_PROVIDER=mock
# Real local transcription via FFmpeg + openai-whisper CLI (both must be
# installed; the whisper model downloads once on first use).
# TRANSCRIPTION_PROVIDER=whisper_cli
WHISPER_BIN=whisper
WHISPER_MODEL=tiny
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Real AI providers (optional, later milestones) ---
# Groq works when AI_PROVIDER=groq plus a key below. The key stays
# server-side and is sent only to the Groq API; it is never logged.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
