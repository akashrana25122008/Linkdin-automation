# LinkedIn AI — local development placeholders only. Never commit real secrets.
# Copy to .env for local runs: Copy-Item .env.example .env

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-dev-only
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/app.db

# --- Mock mode (M0 defaults; no credentials needed) ---
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
LINKEDIN_MODE=mock

# --- Google OAuth (M1, NOT implemented in M0) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LinkedIn OAuth (M9, NOT implemented in M0) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback

# --- Real AI providers (optional, later milestones) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
